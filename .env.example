PARSER_BACKEND=cloud          # "cloud" (Z.AI MaaS) | "ollama" (local Ollama)
Z_AI_API_KEY=None
LOG_LEVEL=INFO
OUTPUT_DIR=./output

# Groq (LLM — OpenAI-compatible API)
GROQ_API_KEY=gsk_YOUR_GROQ_API_KEY_HERE
GROQ_LLM_MODEL=openai/gpt-oss-120b

# NVIDIA (Embeddings — OpenAI-compatible API)
NVIDIA_API_KEY=nvapi-YOUR_NVIDIA_API_KEY_HERE

# Embedding provider
EMBEDDING_PROVIDER=nvidia        # "nvidia" | "gemini"
EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b
EMBEDDING_DIMENSIONS=2048
# ⚠ Changing EMBEDDING_DIMENSIONS after collection creation requires --overwrite

# Gemini (only needed if EMBEDDING_PROVIDER=gemini)
GEMINI_API_KEY=                  # AIzaSy...

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=documents

# Reranker
RERANKER_BACKEND=openai       # "jina" | "openai" | "bge" | "qwen"
RERANKER_TOP_N=5
JINA_API_KEY=                  # only needed if RERANKER_BACKEND=jina

# Feature flags
IMAGE_CAPTION_ENABLED=true

# API server
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1

# Logging
LOG_JSON=false   # true = JSON lines for log aggregators
